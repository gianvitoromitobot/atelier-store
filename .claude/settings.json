{
  "permissions": {
    "allow": [
      "Bash(pnpm *)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(env)",
      "Bash(cat .env*)",
      "Bash(cat */.env*)"
    ]
  }
}
